{
  "name": "brass-runtime",
  "version": "1.22.0",
  "description": "A production HTTP stack for Node, on a small effect runtime with structured concurrency",
  "license": "MIT",
  "author": "Augusto Vivaldelli",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "browser": "./dist/browser/http/index.mjs",
      "import": "./dist/http/index.mjs",
      "require": "./dist/http/index.cjs"
    },
    "./http/testing": {
      "types": "./dist/http/testing.d.ts",
      "import": "./dist/http/testing.mjs",
      "require": "./dist/http/testing.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "require": "./dist/schema/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "browser": "./dist/browser/core/index.mjs",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "browser": "./dist/browser/next.mjs",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "browser": "./dist/browser/observability/index.mjs",
      "import": "./dist/observability/index.mjs",
      "require": "./dist/observability/index.cjs"
    },
    "./perf": {
      "types": "./dist/perf/index.d.ts",
      "import": "./dist/perf/index.mjs",
      "require": "./dist/perf/index.cjs"
    },
    "./package.json": "./package.json",
    "./wasm/pkg/brass_runtime_wasm_engine.js": "./wasm/pkg/brass_runtime_wasm_engine.js",
    "./wasm/pkg/brass_runtime_wasm_engine_bg.wasm": "./wasm/pkg/brass_runtime_wasm_engine_bg.wasm"
  },
  "files": [
    "dist",
    "wasm/pkg",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "docs",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "runtime",
    "functional",
    "effect-system",
    "algebraic-effects",
    "async",
    "effects",
    "fiber",
    "fibers",
    "concurrency",
    "abortcontroller",
    "cancellation",
    "structured-concurrency",
    "typescript",
    "runtime",
    "http-client",
    "retry",
    "circuit-breaker",
    "observability",
    "opentelemetry"
  ],
  "scripts": {
    "dev": "tsx src/examples/index.ts",
    "clean": "node scripts/clean-build-artifacts.mjs",
    "test": "vitest run",
    "test:runtime": "vitest run src/core src/schema src/http src/observability src/__tests__ scripts/__tests__",
    "test:perf": "vitest run src/perf",
    "pretest": "node scripts/check-wasm-artifact.mjs --allow-missing",
    "test:wasm": "npm run build:wasm && node scripts/check-wasm-artifact.mjs --required && vitest run",
    "test:watch": "vitest",
    "test:coverage": "COVERAGE_GATE=baseline vitest run --coverage",
    "test:coverage:report": "COVERAGE_GATE=off vitest run --coverage",
    "test:coverage:100": "COVERAGE_GATE=100 vitest run --coverage",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "test:types:runtime": "tsc -p tsconfig.runtime.json --noEmit",
    "test:types:perf": "tsc -p tsconfig.perf.json --noEmit",
    "test:stability": "vitest run src/core/runtime/__tests__/engine-parity.test.ts src/core/runtime/__tests__/directEffectRunner.test.ts src/core/runtime/__tests__/fiber-transient-cancelers.test.ts src/core/runtime/__tests__/interruptibility.test.ts src/core/runtime/__tests__/scope.test.ts src/core/runtime/__tests__/structured-lifecycle-parity.test.ts src/http/__tests__/adaptiveLimiter.test.ts src/http/__tests__/lifecycleClient.test.ts src/http/__tests__/priorityScheduler.test.ts src/http/__tests__/productionStory.test.ts src/http/__tests__/stability-faults.test.ts src/observability/__tests__/observabilityExport.test.ts",
    "validate:api": "node scripts/check-api-contract.mjs",
    "validate:boundaries": "node scripts/check-product-boundaries.mjs",
    "validate:dependency-security": "node scripts/check-dependency-security.mjs",
    "api:contract:update": "node scripts/check-api-contract.mjs --write",
    "api:v2-map:update": "node scripts/check-v2-export-disposition.mjs --write",
    "validate:v2-map": "node scripts/check-v2-export-disposition.mjs",
    "migrate:v2:analyze": "node scripts/analyze-v2-migration.mjs",
    "adoption:report": "node scripts/report-adopter-metrics.mjs",
    "validate:example:express": "node scripts/validate-express-lighthouse.mjs",
    "validate:example:v2-core": "node scripts/validate-v2-core-lighthouse.mjs",
    "validate:browser": "node scripts/validate-browser.mjs",
    "validate:package": "npm pack --dry-run --json --cache node_modules/.cache/npm-pack | node scripts/validate-package.mjs",
    "validate:products": "node scripts/validate-product-packages.mjs",
    "validate:product:perf": "node scripts/validate-product-packages.mjs perf",
    "validate:product:engine-wasm": "node scripts/validate-product-packages.mjs engine-wasm",
    "validate:evidence": "node scripts/check-production-evidence.mjs && node scripts/check-stability-evidence.mjs && node scripts/check-remote-stability-evidence.mjs && node scripts/check-v2-beta-readiness.mjs && node scripts/check-stable-release-validation.mjs",
    "validate:stability-evidence": "node scripts/check-stability-evidence.mjs && node scripts/check-remote-stability-evidence.mjs",
    "validate:v2-beta-readiness": "node scripts/check-v2-beta-readiness.mjs",
    "validate:adoption-evidence": "node scripts/check-adoption-evidence.mjs && node scripts/check-adoption-signals.mjs",
    "validate:release-policy": "node scripts/check-release-policy.mjs && node scripts/check-release-guardrails.mjs",
    "audit:release-guardrails": "node scripts/audit-release-guardrails.mjs",
    "configure:release-guardrails": "node scripts/configure-release-guardrails.mjs",
    "validate:wasm": "node scripts/check-wasm-artifact.mjs --required",
    "check": "npm run validate:boundaries && npm run validate:dependency-security && npm run validate:evidence && npm run validate:adoption-evidence && npm run validate:release-policy && npm run validate:v2-map && npm run test:types && npm run test && npm run test:coverage",
    "check:full": "npm run clean && npm run build && npm run test",
    "build": "npm run build:wasm && npm run build:ts",
    "build:legacy": "npm run clean && npm run build:types && npm run build:esm && npm run build:cjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "rust:fuzz:check": "cargo +nightly-2026-07-01 fuzz check --fuzz-dir crates/brass-engine-core/fuzz",
    "rust:check": "npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs",
    "benchmark": "tsx src/benchmarks/runner.ts",
    "benchmark:json": "tsx src/benchmarks/runner.ts --json",
    "benchmark:runtime": "tsx src/benchmarks/runner.ts runtime-performance-track",
    "benchmark:runtime:budget": "node scripts/check-runtime-benchmark-budget.mjs",
    "benchmark:runtime:primitives": "tsx src/benchmarks/runner.ts runtime-primitives",
    "benchmark:runtime:primitives:budget": "node scripts/check-runtime-primitives-budget.mjs",
    "benchmark:http": "tsx src/benchmarks/runner.ts http-concurrent",
    "benchmark:http:proxy": "BRASS_HTTP_BENCH_VARIANTS=node-http-text,default-minimal-json,default-proxy-json,default-proxy-node-json,default-json tsx src/benchmarks/runner.ts http-concurrent",
    "benchmark:http:proxy:300tps": "BRASS_HTTP_RAMP_CLIENT=proxy BRASS_HTTP_RAMP_MAX_TPS=300 BRASS_HTTP_RAMP_STEP_TPS=300 BRASS_HTTP_RAMP_STEP_SECONDS=180 BRASS_HTTP_RAMP_CONCURRENCY=600 tsx src/benchmarks/runner.ts http-ramp-tps",
    "benchmark:http:overhead": "tsx src/benchmarks/runner.ts http-local-overhead",
    "benchmark:http:soak": "BRASS_HTTP_BENCH_MODE=soak tsx src/benchmarks/runner.ts http-concurrent",
    "benchmark:http:stability": "node scripts/check-http-stability.mjs",
    "benchmark:http:budget": "node scripts/check-http-benchmark-budget.mjs",
    "benchmark:http:ramp": "tsx src/benchmarks/runner.ts http-ramp-tps",
    "benchmark:adaptive": "tsx src/benchmarks/runner.ts adaptive-limiter-soak",
    "benchmark:adaptive:soak": "BRASS_ADAPTIVE_BENCH_MODE=soak tsx src/benchmarks/runner.ts adaptive-limiter-soak",
    "benchmark:adaptive:stability": "node scripts/check-adaptive-stability.mjs",
    "benchmark:observability": "tsx src/benchmarks/runner.ts observability-overhead",
    "benchmark:observability:budget": "node scripts/check-observability-benchmark-budget.mjs",
    "benchmark:perf": "tsx src/perf/cli.ts --json",
    "perf": "tsx src/perf/cli.ts && node --expose-gc --require tsx/cjs src/benchmarks/http-local-overhead-gate.ts",
    "perf:profile": "tsx src/perf/cli.ts",
    "perf:json": "tsx src/perf/cli.ts --json",
    "perf:runtime:ab": "tsx src/perf/cli.ts --profile runtime-ab",
    "perf:runtime:soak": "tsx src/perf/cli.ts --profile runtime-soak",
    "perf:stability:soak": "node scripts/check-runtime-stability.mjs",
    "stability:manifest": "node scripts/create-stability-run-manifest.mjs",
    "stability:trend": "node scripts/check-stability-trend.mjs",
    "perf:runtime:budget": "tsx src/perf/budgetCli.ts",
    "perf:http:memory": "tsx src/perf/cli.ts --profile http-memory",
    "perf:history": "tsx src/perf/cli.ts --record-history",
    "release:check": "npm run validate:boundaries && npm run validate:dependency-security && npm run validate:evidence && npm run validate:adoption-evidence && npm run validate:release-policy && npm run rust:check && npm run build:wasm && npm run validate:wasm && npm run test:types && npm run test:coverage && npm run build:ts && npm run validate:example:express && npm run validate:api && npm run validate:v2-map && npm run validate:cjs && npm run validate:browser && npm run validate:package && npm run validate:products && npm run validate:product-publish-dry-run && npm run perf:runtime:budget && npm run benchmark:runtime:budget && npm run benchmark:runtime:primitives:budget && npm run benchmark:http:budget && npm run benchmark:observability:budget",
    "example:observability:express": "tsx src/examples/observabilityExpress.ts",
    "example:observability:fastify": "tsx src/examples/observabilityFastify.ts",
    "example:observability:nest": "tsx src/examples/observabilityNest.ts",
    "smoke:observability:collector": "node scripts/observability-collector-smoke.mjs",
    "context": "node scripts/context-pack.mjs",
    "test:coverage:html": "COVERAGE_GATE=off vitest run --coverage --reporter=default",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "tsup",
    "build:v2-beta": "tsup --config tsup.v2-beta.config.ts",
    "validate:v2-beta": "node scripts/validate-v2-beta.mjs",
    "build:product:perf": "tsup --config tsup.perf.config.ts",
    "build:product:engine-wasm": "node scripts/build-engine-wasm-package.mjs",
    "build:products": "npm run build:product:perf && npm run build:product:engine-wasm",
    "validate:cjs": "node scripts/validate-cjs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "vite": "8.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaldrVivaldelli/brass-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/BaldrVivaldelli/brass-runtime/issues"
  },
  "homepage": "https://github.com/BaldrVivaldelli/brass-runtime#readme",
  "bin": {
    "brass-perf": "dist/perf/cli.cjs"
  }
}
